# Crawl4AI MCP Server Environment Configuration
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# LLM Provider API Keys
# =============================================================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Anthropic API Key  
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Azure OpenAI Configuration
# Get from: https://portal.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# =============================================================================
# YouTube Transcript Extraction Configuration
# =============================================================================

# No configuration required for YouTube transcript extraction!
# The youtube-transcript-api v1.1.0+ works out of the box without any API keys or authentication.
# Simply use the YouTube transcript extraction tools directly.

# =============================================================================
# Search and External API Configuration  
# =============================================================================

# Web Search Engines
# =============================================================================
# The search tools (search_web, batch_search_web, search_and_crawl) need an
# configured engine: an API key, or SEARXNG_URL for a self-hosted SearXNG.

# Default engine: auto | google_custom | brave | exa | searxng
# The "engine" request key overrides it for one call.
SEARCH_ENGINE=auto

# Order in which "auto" tries the configured engines. It moves to the
# next engine on errors (rate limit, rejected key, no credits, network, 5xx),
# not on zero results.
SEARCH_ENGINE_ORDER=google_custom,brave,exa,searxng

# Google Custom Search JSON API (closed to new customers, ends on 2027-01-01)
# Get API key from: https://console.cloud.google.com/apis/credentials
# Create search engine at: https://cse.google.com/cse/
GOOGLE_SEARCH_API_KEY=your-google-search-api-key-here
GOOGLE_SEARCH_ENGINE_ID=your-custom-search-engine-id-here
# Requests per minute for the Custom Search API
CUSTOM_SEARCH_API_RPM=100

# Brave Search API: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here

# Exa: https://exa.ai/
EXA_API_KEY=your-exa-api-key-here

# SearXNG (self-hosted metasearch, no API key): https://docs.searxng.org/
# The instance must allow the json format (search.formats in settings.yml).
# SEARXNG_URL=http://localhost:8080
# Optional: SearXNG engines to query (default: the instance's own defaults)
# SEARXNG_ENGINES=google,bing,duckduckgo
# Optional: request timeout in seconds (default 30, at most 120)
# SEARXNG_TIMEOUT=30

# =============================================================================
# Application Configuration
# =============================================================================

# MCP Server Configuration
# Server logging is disabled by default. Set to DEBUG, INFO, WARNING or ERROR
# to write log records to stderr (never stdout, so stdio clients are safe).
# It is read at startup before this file is loaded, so set it in the process
# environment (for example the "env" block of your MCP client config).
# CRAWL4AI_MCP_LOG_LEVEL=INFO

# Python Path (adjust for your environment)
# PYTHONPATH=/path/to/your/venv/lib/python3.10/site-packages

# =============================================================================
# Security Notes
# =============================================================================
# - Never commit this file with real API keys
# - Use environment-specific .env files (.env.development, .env.production)
# - Regularly rotate your API keys for security
# - Check API usage and quotas regularly